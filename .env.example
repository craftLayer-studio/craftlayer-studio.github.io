# Copy to .env.local for local development. Values here are inlined into the
# static build at `next build` time.

# Optional hosted form endpoint for the contact page (Formspree-compatible,
# e.g. https://formspree.io/f/xxxxxxx). This URL is PUBLIC: it ships in the
# browser bundle and is not a secret. Leave empty to fall back to email links.
NEXT_PUBLIC_FORM_ENDPOINT=
